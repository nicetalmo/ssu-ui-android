<?xml version="1.0" encoding="utf-8"?>
<!--
    QR 포스터의 QR 테두리: 흰 바탕 + outline-variant 1.5dp, 모서리 12dp
    네 귀퉁이 표시는 img_qr_scan_frame 을 primary 로 칠해 위에 겹침 (스캔 모서리 선 중심과 맞추려고 2.5dp 안쪽)
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="2.5dp">
    <shape android:shape="rectangle">
        <corners android:radius="9.5dp" />
        <solid android:color="@color/surface" />
        <stroke
            android:width="1.5dp"
            android:color="@color/outline_variant" />
    </shape>
</inset>
