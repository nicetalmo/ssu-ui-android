<?xml version="1.0" encoding="utf-8"?>
<!-- 손님 메인: QR 찍고 줄서기 · 주변 매장 지도 · 사장님 화면 입구 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/main_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/app_name"
                android:src="@drawable/img_logo_small" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:accessibilityHeading="true"
                android:text="@string/main_headline"
                android:textAppearance="@style/TextAppearance.Maeum.HeadlineLarge"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/main_description"
                android:textColor="@color/on_surface_variant" />

            <!-- 어떤 QR 을 찍는지: 사장님이 붙인 QR 포스터 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Maeum.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="64dp"
                        android:layout_height="90dp"
                        android:importantForAccessibility="no"
                        android:padding="0.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_poster_sample"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Maeum.Photo"
                        app:strokeColor="@color/outline_variant"
                        app:strokeWidth="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_poster_title"
                            android:textAppearance="@style/TextAppearance.Maeum.TitleSmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/main_poster_body"
                            android:textAppearance="@style/TextAppearance.Maeum.BodyMedium"
                            android:textColor="@color/on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/main_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/main_scan"
            style="@style/Widget.Maeum.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_scan"
            app:icon="@drawable/ic_qr_scan" />

        <Button
            android:id="@+id/main_open_map"
            style="@style/Widget.Maeum.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_open_map"
            app:icon="@drawable/ic_map" />

        <Button
            android:id="@+id/main_owner_start"
            style="@style/Widget.Maeum.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_owner_start"
            app:icon="@drawable/ic_store" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
