<?xml version="1.0" encoding="utf-8"?>
<!-- 사진 추가 칸 (72dp · primary-container). 매장 사진·메뉴 사진에서 함께 씀 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:background="@drawable/bg_icon_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_add_photo"
        app:tint="@color/on_primary_container" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/photo_add"
        android:textAppearance="@style/TextAppearance.Maeum.Caption"
        android:textColor="@color/on_primary_container" />
</LinearLayout>
