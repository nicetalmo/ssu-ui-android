<?xml version="1.0" encoding="utf-8"?>
<!-- QR 포스터 미리보기 + 인쇄 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".owner.QrPosterActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/poster_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        app:menu="@menu/menu_owner_account"
        app:navigationContentDescription="@string/owner_close"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/poster_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/poster_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/poster_heading"
                    android:textAppearance="@style/TextAppearance.Maeum.HeadlineSmall"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/poster_description"
                    android:textAppearance="@style/TextAppearance.Maeum.BodyMedium"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Maeum.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardElevation="@dimen/elevation_2"
                    app:contentPadding="0dp">

                    <ImageView
                        android:id="@+id/poster_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/poster_title"
                        android:scaleType="fitCenter" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawablePadding="8dp"
                    android:text="@string/poster_pdf_hint"
                    android:textAppearance="@style/TextAppearance.Maeum.BodyMedium"
                    android:textColor="@color/on_surface_variant"
                    app:drawableStartCompat="@drawable/ic_info"
                    app:drawableTint="@color/primary" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/poster_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/primary" />

        <LinearLayout
            android:id="@+id/poster_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/poster_error_text"
                style="@style/Widget.Maeum.ErrorText"
                android:layout_width="wrap_content"
                android:visibility="visible"
                tools:text="매장 정보를 불러오지 못했어요." />

            <Button
                android:id="@+id/poster_retry"
                style="@style/Widget.Maeum.Button.Tonal.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/poster_retry"
                app:icon="@drawable/ic_replay" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding_horizontal">

        <Button
            android:id="@+id/poster_print"
            style="@style/Widget.Maeum.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/poster_print"
            app:icon="@drawable/ic_print" />
    </FrameLayout>

</LinearLayout>
