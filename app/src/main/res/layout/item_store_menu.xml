<?xml version="1.0" encoding="utf-8"?>
<!-- 대기열 만들기 2 / 3 의 메뉴 카드. 누르면 수정, X 는 빼기 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Maeum.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:contentPaddingBottom="8dp"
    app:contentPaddingRight="4dp"
    app:contentPaddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/on_primary_container" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/menu_row_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Maeum.Photo" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 대표 배지는 이름 앞에: 이름이 길어도 배지가 밀려나지 않음 -->
                <TextView
                    android:id="@+id/menu_row_badge"
                    style="@style/Widget.Maeum.Badge"
                    android:layout_marginEnd="6dp"
                    android:text="@string/menu_badge"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/menu_row_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Maeum.TitleSmall"
                    tools:text="트러플 크림 파스타" />
            </LinearLayout>

            <TextView
                android:id="@+id/menu_row_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Maeum.BodyMedium"
                android:textColor="@color/on_surface_variant"
                tools:text="15,000원" />
        </LinearLayout>

        <Button
            android:id="@+id/menu_row_remove"
            style="@style/Widget.Maeum.IconButton.Standard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:icon="@drawable/ic_close" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
