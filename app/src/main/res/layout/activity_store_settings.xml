<?xml version="1.0" encoding="utf-8"?>
<!-- 대기열 만들기 3 / 3 · 운영 설정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".owner.StoreSettingsActivity">

    <include layout="@layout/view_store_step_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="24dp">

            <include layout="@layout/view_store_step_heading" />

            <TextView
                style="@style/Widget.Maeum.TextField.Label"
                android:layout_marginTop="24dp"
                android:labelFor="@id/settings_minutes"
                android:text="@string/settings_minutes_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/settings_minutes_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/settings_minutes_helper"
                app:suffixText="@string/settings_minutes_suffix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/settings_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Maeum.TextField.Label"
                android:layout_marginTop="16dp"
                android:labelFor="@id/settings_max_teams"
                android:text="@string/settings_max_teams_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/settings_max_teams_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/settings_max_teams_helper"
                app:suffixText="@string/settings_max_teams_suffix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/settings_max_teams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Maeum.TextField.Label"
                android:layout_marginTop="16dp"
                android:text="@string/settings_entry_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/settings_entry_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <!-- tag = 입장 제한시간(분). StoreManager 가 받는 값은 3, 5, 10 -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_entry_3"
                    style="@style/Widget.Maeum.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="3"
                    android:text="@string/settings_entry_3" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_entry_5"
                    style="@style/Widget.Maeum.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="5"
                    android:text="@string/settings_entry_5" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_entry_10"
                    style="@style/Widget.Maeum.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="10"
                    android:text="@string/settings_entry_10" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_entry_helper"
                android:textAppearance="@style/TextAppearance.Maeum.BodyMedium"
                android:textColor="@color/on_surface_variant" />

            <TextView
                style="@style/Widget.Maeum.TextField.Label"
                android:layout_marginTop="20dp"
                android:labelFor="@id/settings_notice"
                android:text="@string/settings_notice_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="100">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/settings_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="@string/settings_notice_hint"
                    android:inputType="textMultiLine"
                    android:maxLength="100"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_horizontal">

        <TextView
            android:id="@+id/settings_error"
            style="@style/Widget.Maeum.ErrorText"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/settings_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surface_container_high" />

        <Button
            android:id="@+id/settings_submit"
            style="@style/Widget.Maeum.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_submit" />
    </LinearLayout>

</LinearLayout>
