<?xml version="1.0" encoding="utf-8"?>
<!-- 대기 등록 완료 · 대기표(대기 번호 + 내 앞 대기·예상 시간·인원) + 입장 제한시간 안내 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".customer.JoinDoneActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/done_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/done_close"
        app:navigationIcon="@drawable/ic_close" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/success" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/done_heading"
                android:textAppearance="@style/TextAppearance.Maeum.HeadlineSmall"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/done_store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/on_surface_variant"
                tools:text="성수동 파스타" />

            <!-- 대기표 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Maeum.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardElevation="@dimen/elevation_2"
                app:contentPadding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/done_number_label"
                        android:textAppearance="@style/TextAppearance.Maeum.LabelSmall"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/done_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Maeum.DisplayTicket"
                        android:textColor="@color/primary"
                        tools:text="23" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/done_ahead_label"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/done_ahead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Maeum.TitleSmall"
                            tools:text="4팀" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/done_wait_label"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/done_wait"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Maeum.TitleSmall"
                            tools:text="약 20분" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/done_party_label"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/done_party"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Maeum.TitleSmall"
                            tools:text="2명" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 입장 제한시간 안내 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/done_entry_card"
                style="@style/Widget.Maeum.Card.Notice.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/done_entry_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/on_accent_container"
                    app:drawableStartCompat="@drawable/ic_timer"
                    app:drawableTint="@color/accent"
                    tools:text="번호를 부르면 3분 안에\n매장으로 와 주세요." />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding_horizontal">

        <Button
            android:id="@+id/done_confirm"
            style="@style/Widget.Maeum.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/done_confirm" />
    </FrameLayout>

</LinearLayout>
