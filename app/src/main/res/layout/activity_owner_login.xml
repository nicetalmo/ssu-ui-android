<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".owner.OwnerLoginActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/login_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/owner_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/login_title" />

    <!-- 이미 로그인한 상태로 들어오면 폼 대신 이 화면을 잠깐 보여 주고 내 매장으로 넘어감 -->
    <LinearLayout
        android:id="@+id/login_checking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_checking"
            android:textColor="@color/on_surface_variant" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/login_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/img_logo_large" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="@string/login_heading"
                android:textAppearance="@style/TextAppearance.Maeum.HeadlineSmall"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_description"
                android:textAppearance="@style/TextAppearance.Maeum.BodyMedium"
                android:textColor="@color/on_surface_variant" />

            <TextView
                style="@style/Widget.Maeum.TextField.Label"
                android:layout_marginTop="32dp"
                android:labelFor="@id/login_id"
                android:text="@string/login_id_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:hint="@string/login_id_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Maeum.TextField.Label"
                android:layout_marginTop="20dp"
                android:labelFor="@id/login_password"
                android:text="@string/login_password_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:hint="@string/login_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/login_error"
                style="@style/Widget.Maeum.ErrorText"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/login_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_horizontal">

        <Button
            android:id="@+id/login_submit"
            style="@style/Widget.Maeum.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_submit" />

        <Button
            android:id="@+id/login_sign_up"
            style="@style/Widget.Maeum.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_sign_up" />
    </LinearLayout>

</LinearLayout>
