<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_surface"
    tools:context=".map.MapActivity">

    
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    
    <LinearLayout
        android:id="@+id/map_top_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        
        <FrameLayout
            android:id="@+id/map_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/map_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/map_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/map_back"
                    android:src="@drawable/map_ic_arrow_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/map_title"
                    android:textColor="@color/map_ink"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true"
                    tools:ignore="UnusedAttribute" />
            </LinearLayout>
        </FrameLayout>

       
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/map_chip_sort_wait"
                    style="@style/MapFilterChip"
                    android:text="@string/map_chip_sort_wait" />

                <TextView
                    android:id="@+id/map_chip_walk"
                    style="@style/MapFilterChip"
                    android:text="@string/map_chip_walk" />

                <TextView
                    android:id="@+id/map_chip_booth"
                    style="@style/MapFilterChip"
                    android:text="@string/map_chip_booth" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/map_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/map_bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/map_sheet_peek"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/map_bg_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_sheet_title"
                android:textColor="@color/map_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                android:accessibilityHeading="true"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/map_store_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/map_body"
                android:textSize="13sp"
                tools:text="4곳" />
        </LinearLayout>

        <TextView
            android:id="@+id/map_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:text="@string/map_empty"
            android:textColor="@color/map_body"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/map_store_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
