<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Typography (Figma: Design System · Typography)
        사용: android:textAppearance="@style/TextAppearance.Maeum.TitleLarge"
        글꼴: Noto Sans KR (숫자 표시는 Roboto). 자간은 Figma px 값을 em으로 바꾼 값.
    -->

    <!-- Display/Ticket · Roboto 700 88/96 · 대기 번호 -->
    <style name="TextAppearance.Maeum.DisplayTicket" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">88sp</item>
        <item name="lineHeight">96sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Display/Number · Roboto 700 64/72 · 카운트다운 숫자 -->
    <style name="TextAppearance.Maeum.DisplayNumber" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">64sp</item>
        <item name="lineHeight">72sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Headline/Large · 700 28/38 -->
    <style name="TextAppearance.Maeum.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/noto_sans_kr_bold</item>
        <item name="android:fontFamily">@font/noto_sans_kr_bold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">38sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

