<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 손님 QR 스캔. 카메라가 없는 기기도 설치는 되게 (지도·기본 카메라 앱 링크로 대기 등록 가능) -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSUUI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity
            android:name=".map.MapActivity"
            android:exported="false" />

        <!-- 손님 화면: 메인 → QR 스캔 → 대기 등록 → 등록 완료 -->
        <activity
            android:name=".customer.QrScanActivity"
            android:exported="false" />
        <activity
            android:name=".customer.QueueJoinActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 기본 카메라 앱으로 매장 QR(maeumdaegi://store/{storeId})을 찍으면 바로 열림 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="store"
                    android:scheme="maeumdaegi" />
            </intent-filter>
        </activity>
        <activity
            android:name=".customer.JoinDoneActivity"
            android:exported="false" />

        <!-- 사장님 화면: 로그인·회원가입 → 대기열 만들기 1~3단계(+ 메뉴 추가·수정) → QR 포스터 인쇄 -->
        <activity
            android:name=".owner.OwnerLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".owner.OwnerSignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".owner.StoreInfoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".owner.StoreMenuActivity"
            android:exported="false" />
        <activity
            android:name=".owner.MenuEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".owner.StoreSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".owner.QrPosterActivity"
            android:exported="false" />


        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${NAVER_MAP_CLIENT_ID}" />
    </application>

</manifest>